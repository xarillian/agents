{
  "lastChangelogVersion": "1.0.1",
  "theme": "dark",
  "tuiMode": "fullscreen",
  "quietStartup": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "packages": [
    {
      "source": "./packages/w-usage"
    },
    {
      "source": "./packages/w-footer"
    },
    {
      "source": "npm:pi-subagents"
    },
    {
      "source": "./packages/w-web"
    },
    {
      "source": "./packages/w-clear"
    },
    {
      "source": "./packages/w-startup"
    },
    {
      "source": "./packages/w-deduplicate"
    },
    {
      "source": "./packages/w-effort"
    },
    {
      "source": "./packages/w-quote"
    },
    {
      "source": "./packages/w-spinner-verbs"
    },
    {
      "source": "./packages/w-hotkeys"
    },
    {
      "source": "./packages/w-history"
    },
    {
      "source": "./packages/w-compaction"
    },
    {
      "source": "./packages/w-diviner"
    }
  ],
  "enableSkillCommands": false,
  "showHardwareCursor": false,
  "editorPaddingX": 0,
  "outputPad": 0,
  "doubleEscapeAction": "tree",
  "subagents": {
    "agentOverrides": {
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      }
    }
  }
}