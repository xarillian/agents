{
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
  "tuiMode": "fullscreen",
  "quietStartup": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "packages": [
    {
      "source": "./packages/w-usage"
    },
    {
      "source": "npm:pi-mcp-adapter"
    },
    {
      "source": "npm:pi-subagents"
    },
    {
      "source": "npm:pi-web-access"
    },
    {
      "source": "./packages/w-clear"
    },
    {
      "source": "./packages/w-startup"
    },
    {
      "source": "./packages/w-deduplicate"
    },
    {
      "source": "./packages/w-effort"
    }
  ],
  "enableSkillCommands": false,
  "showHardwareCursor": false,
  "editorPaddingX": 0,
  "outputPad": 0,
  "doubleEscapeAction": "tree",
  "subagents": {
    "agentOverrides": {
      "claude-code": {
        "disabled": true
  },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
  },
  "codex-exec-writer": {
        "disabled": true
      },
  "cursor-agent": {
        "disabled": true
      },
  "cursor-agent-writer": {
        "disabled": true
      }
    }
  } 
}