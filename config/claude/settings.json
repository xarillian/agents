{
  "cleanupPeriodDays": 99999,
  "env": {
    "_ZO_DOCTOR": "0"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(bq show *)",
      "Bash(defaults read *)",
      "Bash(docker compose config *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose ps)",
      "Bash(gcloud logging read *)",
      "Bash(gcloud run revisions describe *)",
      "Bash(gcloud run revisions list *)",
      "Bash(gcloud run services describe *)",
      "Bash(gcloud run services list *)",
      "Bash(git fetch *)",
      "Bash(git fetch)",
      "Bash(glab mr list *)",
      "Bash(glab mr view *)",
      "Bash(hc read *)",
      "Bash(hc wait *)",
      "Bash(herdr-app commands*)",
      "Bash(herdr-app ls*)",
      "mcp__claude_ai_Atlassian__getTransitionsForJiraIssue",
      "mcp__plugin_andgo-company_atlassian__getAccessibleAtlassianResources",
      "mcp__plugin_andgo-company_atlassian__getConfluenceContent",
      "mcp__plugin_andgo-company_atlassian__getJiraIssue",
      "mcp__plugin_andgo-company_atlassian__searchJiraIssuesUsingJql",
      "mcp__plugin_andgo-company_gitlab__get_job",
      "mcp__plugin_andgo-company_gitlab__get_merge_request",
      "mcp__plugin_andgo-company_gitlab__get_pipeline",
      "mcp__plugin_andgo-company_gitlab__get_repository_file",
      "mcp__plugin_andgo-company_gitlab__get_user",
      "mcp__plugin_andgo-company_gitlab__list_commits",
      "mcp__plugin_andgo-company_gitlab__list_merge_requests",
      "mcp__plugin_andgo-company_gitlab__list_repository_tree",
      "mcp__plugin_andgo-company_slack__slack_search_public_and_private"
    ]
  },
  "bashEditDiffEnabled": false,
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "codex@openai-codex": false,
    "skill-creator@claude-plugins-official": true,
    "review@xarillian-agents": true,
    "quote@xarillian-agents": true,
    "cc-plugin-you-should-know@builtin": true,
    "w-footer@xarillian-agents": true,
    "frontend-design@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "employee-need-shift-splash@andgo-plugins": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "xarillian-agents": {
      "source": {
        "source": "github",
        "repo": "xarillian/agents"
      }
    },
    "andgo-plugins": {
      "source": {
        "source": "git",
        "url": "https://gitlab.dev.ncconsulting.ca/consulting/agent-marketplace.git"
      }
    }
  },
  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "Channelling",
      "Consulting the void",
      "Observing the mysteries",
      "Pondering the secrets of the divine",
      "Reaping"
    ]
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": true,
  "showThinkingSummaries": true,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark-daltonized",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true
}
