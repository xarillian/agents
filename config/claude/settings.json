{
  "model": "opus",
  "env": {
    "GIT_CONFIG_COUNT": "2",
    "GIT_CONFIG_KEY_0": "hook.stripAttribution.command",
    "GIT_CONFIG_VALUE_0": "~/.agents/config/claude/hooks/strip-attribution.sh",
    "GIT_CONFIG_KEY_1": "hook.stripAttribution.event",
    "GIT_CONFIG_VALUE_1": "commit-msg"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "codex@openai-codex": true,
    "skill-creator@claude-plugins-official": true,
    "review@xarillian-agents": true
