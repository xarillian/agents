{
  "warn-on-drift": {
    "SessionStart": [
      {
        "type": "command",
        "command": "\"$HOME/.agents/hooks/warn-on-drift.sh\" --antigravity",
        "timeout": 10
      }
    ]
  },
  "herdr-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "\"$HOME/.agents/hooks/herdr-context.sh\" --antigravity",
        "timeout": 5
      }
    ]
  },
  "log-skill-use": {
    "PostToolUse": [
      {
        "matcher": "read_file",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/log-skill-use.sh\" --antigravity",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "herdr-title": {
    "SessionStart": [
      {
        "type": "command",
        "command": "\"$HOME/.agents/harnesses/antigravity/footer/footer.mjs\" --hook",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"$HOME/.agents/harnesses/antigravity/footer/footer.mjs\" --hook",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "\"$HOME/.agents/harnesses/antigravity/footer/footer.mjs\" --hook",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"$HOME/.agents/harnesses/antigravity/footer/footer.mjs\" --hook",
        "timeout": 5
      }
    ]
  }
}
